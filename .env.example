# ──────────────────────────────────────────────────────────────────────────
# LUNA · powered by MHIN — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# Two trust zones:
#   VITE_*          → bundled into the browser. PUBLIC values only.
#   everything else → server-side only (verify script + Appwrite Functions).
#                     These hold the real SECRETS and never reach the client.
# ──────────────────────────────────────────────────────────────────────────

# ── Appwrite (browser-safe, public) ────────────────────────────────────────
# The MIRA project is baked into src/lib/config.js as the default; set these
# only to override (e.g. a different environment).
#
# To activate REAL email verification (src/lib/auth.js registerAndSendVerification
# / resendVerificationEmail / confirmEmailVerification), in the Appwrite Console:
#   1. Auth → Settings → enable the "Email/Password" method.
#   2. Settings → SMTP → configure a real sender (or use Appwrite's default
#      sender for testing — check current delivery limits for your plan).
#   3. Settings → Platforms → add a Web platform for every origin you deploy
#      to (localhost during dev, your real domain in production) — Appwrite
#      rejects browser requests from origins it doesn't recognise.
#   4. Auth → Templates → Verification — customise the emailed template if
#      you want MIRA branding instead of the Appwrite default.
# Without these, signup and login still work fully locally (this app's own
# account store) — only the real email send/confirm step stays inactive, and
# the "Check your email" screen says so honestly instead of pretending.
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6a474b7b000721c88976
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_COLLECTION_LOGS=logs
VITE_APPWRITE_COLLECTION_CYCLE_STATE=cycle_state
VITE_APPWRITE_COLLECTION_RISK_FLAGS=risk_flags

# Base URL of your deployed server functions (Anthropic proxy, STT/TTS proxy…)
VITE_FUNCTIONS_BASE_URL=

# ── Google Sign-In (browser-safe, public) ────────────────────────────────────
# Create an OAuth Client ID (type "Web application") in Google Cloud Console →
# APIs & Services → Credentials, add your deployed origin(s) to "Authorized
# JavaScript origins", then paste the client id here. Without this, "Continue
# with Google" falls back to the preview's email sign-in form instead of
# Google's real account chooser.
VITE_GOOGLE_CLIENT_ID=
# Server-side copy of the SAME client id (not a secret — needed so the /auth/
# google proxy can check the token's audience). Leave blank to skip server
# verification; the browser then trusts its own decode of the Google token.
GOOGLE_CLIENT_ID=

# ── Appwrite server API key (SECRET — server/CI only) ───────────────────────
# Used by scripts/verify-connections.mjs and Appwrite Functions. Scope it to the
# minimum needed (databases.read/write). Do NOT prefix with VITE_.
APPWRITE_API_KEY=

# ── Anthropic (SECRET — server only) ────────────────────────────────────────
APP_ANTHROPIC_API_KEY=
# Smoke-test model for the verify script. Use a current, available model id.
APP_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Tamil STT/TTS provider — Sarvam AI (SECRET — server only) ────────────────
VOICE_PROVIDER=sarvam
SARVAM_API_KEY=
# Tamil. saarika:v2.5 = STT model, bulbul:v2 = TTS model.
SARVAM_LANGUAGE_CODE=ta-IN
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka

# ── Server proxy ────────────────────────────────────────────────────────────
# The Node service (server/) that holds the secrets above and exposes
# /extract, /stt, /tts. Point VITE_FUNCTIONS_BASE_URL at this in .env too.
SERVER_PORT=8787
# Comma-separated browser origins allowed to call the proxy (CORS).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── SMS fallback (optional, Phase 12 — SECRET) ──────────────────────────────
SMS_PROVIDER=
SMS_API_KEY=
